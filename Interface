package Oops;
import java.util.*;
interface Vehicle
{
	void start();
}
 class Car implements Vehicle
{
	 public void start()
	 {
		 System.out.println("Car Started");
	}
	
}
 class Bike implements Vehicle
 {
	 public void start()
	 {
		 System.out.print("Bike started");
	 }
 }
public class Interface {
public static void main(String[]args)
{
	Car c=new Car();
	Bike b=new Bike();
	c.start();
	b.start();
}
}
